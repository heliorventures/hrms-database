# Variables used by docker-compose.yml in this directory.
# Copy to `.env` here (Compose loads it automatically) or set in the shell.

POSTGRES_DB=kabipay_dev
POSTGRES_USER=kabipay
POSTGRES_PASSWORD=changeme
# Host port published to your machine (5432 inside the container is always 5432).
POSTGRES_PORT=5432

# Optional pgAdmin (`docker compose --profile tools up -d pgadmin`)
PGADMIN_EMAIL=admin@localhost.dev
PGADMIN_PASSWORD=changeme
PGADMIN_PORT=5050

# For Liquibase and app JDBC URLs against this container, use host `localhost`
# and the same POSTGRES_PORT, database name, user, and password as above.
