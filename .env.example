# Copy to `.env` in this directory. Used by `npm run migrate-ops`,
# `node run-sql.cjs`, and the scripts under `scripts/`.
#

# Local dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kabipay_dev
POSTGRES_USER=kabipay
POSTGRES_PASSWORD=changeme

# Neon (pooler) - use *-pooler* host, port 5432, DB name from dashboard (e.g. neondb)
# POSTGRES_HOST=ep-XXXXX-pooler.REGION.aws.neon.tech
# POSTGRES_PORT=5432
# POSTGRES_DB=neondb
# POSTGRES_USER=neondb_owner
# POSTGRES_PASSWORD=your_password
# POSTGRES_SSLMODE=require

# Managed DB (Aiven, etc.) - set when TLS is required; must match the server.
# POSTGRES_SSLMODE=require

# Optional Liquibase user/password (defaults to POSTGRES_USER / POSTGRES_PASSWORD if unset)
# KABIPAY_DB_USER=
# KABIPAY_DB_PASSWORD=

# Optional: single JDBC string for ad-hoc Liquibase only (not used by `migrate-ops` by default)
# KABIPAY_JDBC_URL=jdbc:postgresql://ep-XXXXX-pooler.REGION.aws.neon.tech:5432/neondb?sslmode=require
