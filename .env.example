# Copy to `.env` in this directory. Used by `npm run migrate-ops`, `node run-sql.cjs`, and
# (when you run them from a sibling `kabipay-svc`) the provisioning scripts after they merge
# with optional `../kabipay-svc/.env`.
#
# In a monorepo with both repos: you can keep connection-only vars here, or only in
# `../kabipay-svc/.env` — values in *this* file win when both are present.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kabipay_dev
POSTGRES_USER=kabipay
POSTGRES_PASSWORD=changeme

# Managed DB (Aiven, etc.) — set when TLS is required; must match the server.
# POSTGRES_SSLMODE=require

# Optional Liquibase user/password (defaults to POSTGRES_USER / POSTGRES_PASSWORD if unset)
# KABIPAY_DB_USER=
# KABIPAY_DB_PASSWORD=

# Optional: single JDBC string for ad-hoc Liquibase only (not used by `migrate-ops` by default)
# KABIPAY_JDBC_URL=jdbc:postgresql://HOST:PORT/dbname?sslmode=require
