    <!-- DOMAIN 0019 — LMS. content_url → content_file_storage_id (defer FK to 0029). certification.file_storage_id deferred to 0029. -->

    <changeSet id="0019-001-create-skill" author="kabipay-dev">
        <createTable tableName="skill" schemaName="${schema}">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="category" type="VARCHAR(100)"/>
            <column name="level" type="VARCHAR(50)"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="skill" schemaName="${schema}" indexName="idx_skill_tenant">
            <column name="tenant_id"/>
        </createIndex>
        <sql>CREATE TRIGGER trg_skill_updated_at BEFORE UPDATE ON "${schema}".skill FOR EACH ROW EXECUTE FUNCTION kabipay_ops.set_updated_at();</sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS trg_skill_updated_at ON "${schema}".skill;</sql>
            <dropTable tableName="skill" schemaName="${schema}"/>
        </rollback>
    </changeSet>

