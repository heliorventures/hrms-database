            <column name="descriptor" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="competency_level" schemaName="${schema}"
                             columnNames="competency_id,level"
                             constraintName="uq_competency_level_comp_level"/>
        <createIndex tableName="competency_level" schemaName="${schema}" indexName="idx_competency_level_competency">
            <column name="competency_id"/>
        </createIndex>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="competency_level" baseColumnNames="competency_id"
                                 referencedTableSchemaName="${schema}" referencedTableName="competency" referencedColumnNames="id"
                                 constraintName="fk_competency_level_competency" onDelete="CASCADE"/>
        <sql>CREATE TRIGGER trg_competency_level_updated_at BEFORE UPDATE ON "${schema}".competency_level FOR EACH ROW EXECUTE FUNCTION kabipay_ops.set_updated_at();</sql>
        <rollback>
