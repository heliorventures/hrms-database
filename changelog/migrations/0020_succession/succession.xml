    <!-- DOMAIN 0020 — SUCCESSION (depends on 0018 review_cycle). -->

    <changeSet id="0020-001-create-competency" author="kabipay-dev">
        <createTable tableName="competency" schemaName="${schema}">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="category" type="VARCHAR(100)"/>
            <column name="description" type="TEXT"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="competency" schemaName="${schema}" indexName="idx_competency_tenant">
            <column name="tenant_id"/>
        </createIndex>
        <sql>CREATE TRIGGER trg_competency_updated_at BEFORE UPDATE ON "${schema}".competency FOR EACH ROW EXECUTE FUNCTION kabipay_ops.set_updated_at();</sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS trg_competency_updated_at ON "${schema}".competency;</sql>
            <dropTable tableName="competency" schemaName="${schema}"/>
        </rollback>
    </changeSet>

