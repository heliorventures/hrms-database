<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="0049-001-add-user-must-change-password" author="kabipay-dev">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <columnExists tableName="user" schemaName="${schema}" columnName="must_change_password"/>
            </not>
        </preConditions>
        <comment>Track temporary admin-set passwords so users are forced to change them at next login.</comment>
        <addColumn tableName="user" schemaName="${schema}">
            <column name="must_change_password" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="user" schemaName="${schema}" columnName="must_change_password"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
