<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="0046-001-user-notification-preference" author="kabipay-dev">
        <createTable tableName="user_notification_preference" schemaName="${schema}">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="in_app_enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="announcements_enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="muted_topics" type="JSONB" defaultValueComputed="'[]'::jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="user_notification_preference" schemaName="${schema}"
                             columnNames="tenant_id, user_id"
                             constraintName="uq_user_notification_pref_tenant_user"/>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="user_notification_preference" baseColumnNames="user_id"
                                 referencedTableSchemaName="${schema}" referencedTableName="user" referencedColumnNames="id"
                                 constraintName="fk_user_notif_pref_user" onDelete="CASCADE"/>
        <sql>CREATE TRIGGER trg_user_notif_pref_updated_at BEFORE UPDATE ON "${schema}".user_notification_preference FOR EACH ROW EXECUTE FUNCTION kabipay_ops.set_updated_at();</sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS trg_user_notif_pref_updated_at ON "${schema}".user_notification_preference;</sql>
            <dropTable tableName="user_notification_preference" schemaName="${schema}"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
