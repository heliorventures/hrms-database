<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- DOMAIN 0029 — FILE STORAGE (ERD §29, Gap F). Central place for file_storage_id FK targets across the client plane. -->

    <changeSet id="0029-001-create-file-storage" author="kabipay-dev">
        <createTable tableName="file_storage" schemaName="${schema}">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="provider" type="VARCHAR(50)"><constraints nullable="false"/></column>
            <column name="bucket" type="VARCHAR(255)"/>
            <column name="storage_path" type="TEXT"><constraints nullable="false"/></column>
            <column name="original_filename" type="VARCHAR(500)"/>
            <column name="mime_type" type="VARCHAR(255)"/>
            <column name="file_size_bytes" type="BIGINT"/>
            <column name="is_public" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="uploaded_by" type="UUID"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="file_storage" schemaName="${schema}" indexName="idx_file_storage_tenant">
            <column name="tenant_id"/>
        </createIndex>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="file_storage" baseColumnNames="uploaded_by"
                                 referencedTableSchemaName="${schema}" referencedTableName="user" referencedColumnNames="id"
                                 constraintName="fk_file_storage_uploaded_by" onDelete="SET NULL"/>
        <sql>CREATE TRIGGER trg_file_storage_updated_at BEFORE UPDATE ON "${schema}".file_storage FOR EACH ROW EXECUTE FUNCTION kabipay_ops.set_updated_at();</sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS trg_file_storage_updated_at ON "${schema}".file_storage;</sql>
            <dropTable tableName="file_storage" schemaName="${schema}"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
