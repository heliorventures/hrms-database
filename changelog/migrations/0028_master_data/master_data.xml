<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- DOMAIN 0028 — TENANT MASTER_DATA (ERD §29, Gap E). Tenant-configurable enum-like key/value rows. -->

    <changeSet id="0028-001-create-master-data" author="kabipay-dev">
        <createTable tableName="master_data" schemaName="${schema}">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="category" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="data_key" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="value" type="VARCHAR(500)"><constraints nullable="false"/></column>
            <column name="description" type="TEXT"/>
            <column name="display_order" type="INT"/>
            <column name="is_system" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="master_data" schemaName="${schema}"
                             columnNames="tenant_id,category,data_key"
                             constraintName="uq_master_data_tenant_category_key"/>
        <createIndex tableName="master_data" schemaName="${schema}" indexName="idx_master_data_tenant_category">
            <column name="tenant_id"/>
            <column name="category"/>
        </createIndex>
        <sql>CREATE TRIGGER trg_master_data_updated_at BEFORE UPDATE ON "${schema}".master_data FOR EACH ROW EXECUTE FUNCTION kabipay_ops.set_updated_at();</sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS trg_master_data_updated_at ON "${schema}".master_data;</sql>
            <dropTable tableName="master_data" schemaName="${schema}"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
