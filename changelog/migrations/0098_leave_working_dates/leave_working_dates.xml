<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="0098-leave-working-dates" author="codex">
    <addUniqueConstraint tableName="leave_request" schemaName="${schema}" columnNames="tenant_id,id,employee_id" constraintName="uq_leave_request_calendar_owner"/>
    <createTable tableName="leave_working_date_snapshot" schemaName="${schema}">
      <column name="leave_request_id" type="UUID"><constraints nullable="false" primaryKey="true"/></column>
      <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
      <column name="employee_id" type="UUID"><constraints nullable="false"/></column>
      <column name="from_date" type="DATE"><constraints nullable="false"/></column>
      <column name="to_date" type="DATE"><constraints nullable="false"/></column>
      <column name="requested_days" type="NUMERIC(10,2)"><constraints nullable="false"/></column>
      <column name="date_units" type="JSONB"><constraints nullable="false"/></column>
      <column name="calendar_provenance" type="JSONB"><constraints nullable="false"/></column>
      <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
    </createTable>
    <addForeignKeyConstraint constraintName="fk_leave_dates_request_tenant" baseTableSchemaName="${schema}" baseTableName="leave_working_date_snapshot" baseColumnNames="tenant_id,leave_request_id,employee_id" referencedTableSchemaName="${schema}" referencedTableName="leave_request" referencedColumnNames="tenant_id,id,employee_id"/>
    <addForeignKeyConstraint constraintName="fk_leave_dates_employee_tenant" baseTableSchemaName="${schema}" baseTableName="leave_working_date_snapshot" baseColumnNames="tenant_id,employee_id" referencedTableSchemaName="${schema}" referencedTableName="employee" referencedColumnNames="tenant_id,id"/>
    <createIndex tableName="leave_working_date_snapshot" schemaName="${schema}" indexName="idx_leave_dates_tenant_employee"><column name="tenant_id"/><column name="employee_id"/></createIndex>
    <sql><![CDATA[ALTER TABLE ${schema}.leave_working_date_snapshot ADD CONSTRAINT ck_leave_dates_snapshot CHECK (from_date <= to_date AND requested_days > 0 AND jsonb_typeof(date_units) = 'array' AND jsonb_typeof(calendar_provenance) = 'object');]]></sql>
    <rollback><dropTable tableName="leave_working_date_snapshot" schemaName="${schema}"/><dropUniqueConstraint tableName="leave_request" schemaName="${schema}" constraintName="uq_leave_request_calendar_owner"/></rollback>
  </changeSet>
</databaseChangeLog>
