<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- DOMAIN 0011 — LEAVE. workflow_instance_id is UUID until domain 0025. -->

    <changeSet id="0011-001-create-leave-type" author="kabipay-dev">
        <createTable tableName="leave_type" schemaName="${schema}">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="code" type="VARCHAR(50)"><constraints nullable="false"/></column>
            <column name="is_paid" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="carry_forward" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="max_carry_forward_days" type="INT"/>
            <column name="sandwich_rule" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="half_day_allowed" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="requires_document" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="deleted_at" type="TIMESTAMPTZ"/>
            <column name="deleted_by" type="UUID"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="leave_type" schemaName="${schema}"
                             columnNames="tenant_id,code"
                             constraintName="uq_leave_type_tenant_code"/>
        <createIndex tableName="leave_type" schemaName="${schema}" indexName="idx_leave_type_tenant">
            <column name="tenant_id"/>
        </createIndex>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="leave_type" baseColumnNames="deleted_by"
                                 referencedTableSchemaName="${schema}" referencedTableName="user" referencedColumnNames="id"
                                 constraintName="fk_leave_type_deleted_by" onDelete="SET NULL"/>
        <sql>CREATE TRIGGER trg_leave_type_updated_at BEFORE UPDATE ON "${schema}".leave_type FOR EACH ROW EXECUTE FUNCTION kabipay_ops.set_updated_at();</sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS trg_leave_type_updated_at ON "${schema}".leave_type;</sql>
            <dropTable tableName="leave_type" schemaName="${schema}"/>
        </rollback>
    </changeSet>

    <changeSet id="0011-002-create-leave-policy" author="kabipay-dev">
        <createTable tableName="leave_policy" schemaName="${schema}">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="leave_type_id" type="UUID"><constraints nullable="false"/></column>
            <column name="applicable_to" type="VARCHAR(100)"/>
            <column name="annual_entitlement" type="INT"/>
            <column name="accrual_frequency" type="VARCHAR(50)"/>
            <column name="accrual_days" type="NUMERIC(15,4)"/>
            <column name="max_consecutive_days" type="INT"/>
            <column name="min_notice_days" type="INT"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="leave_policy" schemaName="${schema}" indexName="idx_leave_policy_tenant">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex tableName="leave_policy" schemaName="${schema}" indexName="idx_leave_policy_type">
            <column name="leave_type_id"/>
        </createIndex>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="leave_policy" baseColumnNames="leave_type_id"
                                 referencedTableSchemaName="${schema}" referencedTableName="leave_type" referencedColumnNames="id"
                                 constraintName="fk_leave_policy_leave_type" onDelete="CASCADE"/>
        <sql>CREATE TRIGGER trg_leave_policy_updated_at BEFORE UPDATE ON "${schema}".leave_policy FOR EACH ROW EXECUTE FUNCTION kabipay_ops.set_updated_at();</sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS trg_leave_policy_updated_at ON "${schema}".leave_policy;</sql>
            <dropTable tableName="leave_policy" schemaName="${schema}"/>
        </rollback>
    </changeSet>

    <changeSet id="0011-003-create-leave-balance" author="kabipay-dev">
        <createTable tableName="leave_balance" schemaName="${schema}">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="employee_id" type="UUID"><constraints nullable="false"/></column>
            <column name="leave_type_id" type="UUID"><constraints nullable="false"/></column>
            <column name="year" type="INT"><constraints nullable="false"/></column>
            <column name="entitled_days" type="NUMERIC(15,4)" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="used_days" type="NUMERIC(15,4)" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="pending_days" type="NUMERIC(15,4)" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="carried_forward_days" type="NUMERIC(15,4)" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="balance_days" type="NUMERIC(15,4)" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="leave_balance" schemaName="${schema}"
                             columnNames="employee_id,leave_type_id,year"
                             constraintName="uq_leave_balance_emp_type_year"/>
        <createIndex tableName="leave_balance" schemaName="${schema}" indexName="idx_leave_balance_tenant">
            <column name="tenant_id"/>
        </createIndex>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="leave_balance" baseColumnNames="employee_id"
                                 referencedTableSchemaName="${schema}" referencedTableName="employee" referencedColumnNames="id"
                                 constraintName="fk_leave_balance_employee" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="leave_balance" baseColumnNames="leave_type_id"
                                 referencedTableSchemaName="${schema}" referencedTableName="leave_type" referencedColumnNames="id"
                                 constraintName="fk_leave_balance_leave_type" onDelete="RESTRICT"/>
        <sql>CREATE TRIGGER trg_leave_balance_updated_at BEFORE UPDATE ON "${schema}".leave_balance FOR EACH ROW EXECUTE FUNCTION kabipay_ops.set_updated_at();</sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS trg_leave_balance_updated_at ON "${schema}".leave_balance;</sql>
            <dropTable tableName="leave_balance" schemaName="${schema}"/>
        </rollback>
    </changeSet>

    <changeSet id="0011-004-create-leave-accrual-log" author="kabipay-dev">
        <createTable tableName="leave_accrual_log" schemaName="${schema}">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="employee_id" type="UUID"><constraints nullable="false"/></column>
            <column name="leave_type_id" type="UUID"><constraints nullable="false"/></column>
            <column name="days_credited" type="NUMERIC(15,4)"><constraints nullable="false"/></column>
            <column name="reason" type="VARCHAR(500)"/>
            <column name="credited_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="leave_accrual_log" schemaName="${schema}" indexName="idx_leave_accrual_employee">
            <column name="employee_id"/>
        </createIndex>
        <createIndex tableName="leave_accrual_log" schemaName="${schema}" indexName="idx_leave_accrual_tenant">
            <column name="tenant_id"/>
        </createIndex>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="leave_accrual_log" baseColumnNames="employee_id"
                                 referencedTableSchemaName="${schema}" referencedTableName="employee" referencedColumnNames="id"
                                 constraintName="fk_leave_accrual_employee" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="leave_accrual_log" baseColumnNames="leave_type_id"
                                 referencedTableSchemaName="${schema}" referencedTableName="leave_type" referencedColumnNames="id"
                                 constraintName="fk_leave_accrual_leave_type" onDelete="RESTRICT"/>
        <rollback>
            <dropTable tableName="leave_accrual_log" schemaName="${schema}"/>
        </rollback>
    </changeSet>

    <changeSet id="0011-005-create-leave-request" author="kabipay-dev">
        <createTable tableName="leave_request" schemaName="${schema}">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="employee_id" type="UUID"><constraints nullable="false"/></column>
            <column name="leave_type_id" type="UUID"><constraints nullable="false"/></column>
            <column name="from_date" type="DATE"><constraints nullable="false"/></column>
            <column name="to_date" type="DATE"><constraints nullable="false"/></column>
            <column name="days_requested" type="NUMERIC(15,4)"><constraints nullable="false"/></column>
            <column name="is_half_day" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="half_day_session" type="VARCHAR(20)"/>
            <column name="status" type="VARCHAR(50)"><constraints nullable="false"/></column>
            <column name="reason" type="VARCHAR(1000)"/>
            <column name="rejection_reason" type="VARCHAR(1000)"/>
            <column name="approved_by" type="UUID"/>
            <column name="workflow_instance_id" type="UUID"/>
            <column name="applied_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="deleted_at" type="TIMESTAMPTZ"/>
            <column name="deleted_by" type="UUID"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="leave_request" schemaName="${schema}" indexName="idx_leave_request_employee">
            <column name="employee_id"/>
        </createIndex>
        <createIndex tableName="leave_request" schemaName="${schema}" indexName="idx_leave_request_tenant">
            <column name="tenant_id"/>
        </createIndex>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="leave_request" baseColumnNames="employee_id"
                                 referencedTableSchemaName="${schema}" referencedTableName="employee" referencedColumnNames="id"
                                 constraintName="fk_leave_request_employee" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="leave_request" baseColumnNames="leave_type_id"
                                 referencedTableSchemaName="${schema}" referencedTableName="leave_type" referencedColumnNames="id"
                                 constraintName="fk_leave_request_leave_type" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="leave_request" baseColumnNames="approved_by"
                                 referencedTableSchemaName="${schema}" referencedTableName="user" referencedColumnNames="id"
                                 constraintName="fk_leave_request_approved_by" onDelete="SET NULL"/>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="leave_request" baseColumnNames="deleted_by"
                                 referencedTableSchemaName="${schema}" referencedTableName="user" referencedColumnNames="id"
                                 constraintName="fk_leave_request_deleted_by" onDelete="SET NULL"/>
        <sql>CREATE TRIGGER trg_leave_request_updated_at BEFORE UPDATE ON "${schema}".leave_request FOR EACH ROW EXECUTE FUNCTION kabipay_ops.set_updated_at();</sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS trg_leave_request_updated_at ON "${schema}".leave_request;</sql>
            <dropTable tableName="leave_request" schemaName="${schema}"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
