<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- DOMAIN 0014 — BENEFITS -->

    <changeSet id="0014-001-create-benefit-type" author="kabipay-dev">
        <createTable tableName="benefit_type" schemaName="${schema}">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="code" type="VARCHAR(50)"><constraints nullable="false"/></column>
            <column name="category" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="benefit_type" schemaName="${schema}"
                             columnNames="tenant_id,code"
                             constraintName="uq_benefit_type_tenant_code"/>
        <createIndex tableName="benefit_type" schemaName="${schema}" indexName="idx_benefit_type_tenant">
            <column name="tenant_id"/>
        </createIndex>
        <sql>CREATE TRIGGER trg_benefit_type_updated_at BEFORE UPDATE ON "${schema}".benefit_type FOR EACH ROW EXECUTE FUNCTION kabipay_ops.set_updated_at();</sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS trg_benefit_type_updated_at ON "${schema}".benefit_type;</sql>
            <dropTable tableName="benefit_type" schemaName="${schema}"/>
        </rollback>
    </changeSet>

    <changeSet id="0014-002-create-benefit-plan" author="kabipay-dev">
        <createTable tableName="benefit_plan" schemaName="${schema}">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="benefit_type_id" type="UUID"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="employer_contribution" type="NUMERIC(15,4)"/>
            <column name="employee_contribution" type="NUMERIC(15,4)"/>
            <column name="contribution_type" type="VARCHAR(50)"/>
            <column name="is_mandatory" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="benefit_plan" schemaName="${schema}" indexName="idx_benefit_plan_tenant">
            <column name="tenant_id"/>
        </createIndex>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="benefit_plan" baseColumnNames="benefit_type_id"
                                 referencedTableSchemaName="${schema}" referencedTableName="benefit_type" referencedColumnNames="id"
                                 constraintName="fk_benefit_plan_benefit_type" onDelete="RESTRICT"/>
        <sql>CREATE TRIGGER trg_benefit_plan_updated_at BEFORE UPDATE ON "${schema}".benefit_plan FOR EACH ROW EXECUTE FUNCTION kabipay_ops.set_updated_at();</sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS trg_benefit_plan_updated_at ON "${schema}".benefit_plan;</sql>
            <dropTable tableName="benefit_plan" schemaName="${schema}"/>
        </rollback>
    </changeSet>

    <changeSet id="0014-003-create-employee-benefit-enrollment" author="kabipay-dev">
        <createTable tableName="employee_benefit_enrollment" schemaName="${schema}">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="employee_id" type="UUID"><constraints nullable="false"/></column>
            <column name="benefit_plan_id" type="UUID"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(50)"><constraints nullable="false"/></column>
            <column name="enrolled_on" type="DATE"/>
            <column name="effective_from" type="DATE"><constraints nullable="false"/></column>
            <column name="effective_to" type="DATE"/>
            <column name="employee_contribution_amount" type="NUMERIC(15,4)"/>
            <column name="employer_contribution_amount" type="NUMERIC(15,4)"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="employee_benefit_enrollment" schemaName="${schema}" indexName="idx_emp_benefit_enroll_employee">
            <column name="employee_id"/>
        </createIndex>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="employee_benefit_enrollment" baseColumnNames="employee_id"
                                 referencedTableSchemaName="${schema}" referencedTableName="employee" referencedColumnNames="id"
                                 constraintName="fk_emp_benefit_enroll_employee" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="employee_benefit_enrollment" baseColumnNames="benefit_plan_id"
                                 referencedTableSchemaName="${schema}" referencedTableName="benefit_plan" referencedColumnNames="id"
                                 constraintName="fk_emp_benefit_enroll_plan" onDelete="RESTRICT"/>
        <sql>CREATE TRIGGER trg_employee_benefit_enrollment_updated_at BEFORE UPDATE ON "${schema}".employee_benefit_enrollment FOR EACH ROW EXECUTE FUNCTION kabipay_ops.set_updated_at();</sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS trg_employee_benefit_enrollment_updated_at ON "${schema}".employee_benefit_enrollment;</sql>
            <dropTable tableName="employee_benefit_enrollment" schemaName="${schema}"/>
        </rollback>
    </changeSet>

    <changeSet id="0014-004-create-benefit-claim" author="kabipay-dev">
        <createTable tableName="benefit_claim" schemaName="${schema}">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="employee_id" type="UUID"><constraints nullable="false"/></column>
            <column name="benefit_plan_id" type="UUID"><constraints nullable="false"/></column>
            <column name="amount" type="NUMERIC(15,4)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(50)"><constraints nullable="false"/></column>
            <column name="claim_date" type="DATE"><constraints nullable="false"/></column>
            <column name="file_storage_id" type="UUID"/>
            <column name="rejection_reason" type="VARCHAR(1000)"/>
            <column name="workflow_instance_id" type="UUID"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="deleted_at" type="TIMESTAMPTZ"/>
            <column name="deleted_by" type="UUID"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="benefit_claim" schemaName="${schema}" indexName="idx_benefit_claim_employee">
            <column name="employee_id"/>
        </createIndex>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="benefit_claim" baseColumnNames="employee_id"
                                 referencedTableSchemaName="${schema}" referencedTableName="employee" referencedColumnNames="id"
                                 constraintName="fk_benefit_claim_employee" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="benefit_claim" baseColumnNames="benefit_plan_id"
                                 referencedTableSchemaName="${schema}" referencedTableName="benefit_plan" referencedColumnNames="id"
                                 constraintName="fk_benefit_claim_plan" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="benefit_claim" baseColumnNames="deleted_by"
                                 referencedTableSchemaName="${schema}" referencedTableName="user" referencedColumnNames="id"
                                 constraintName="fk_benefit_claim_deleted_by" onDelete="SET NULL"/>
        <sql>CREATE TRIGGER trg_benefit_claim_updated_at BEFORE UPDATE ON "${schema}".benefit_claim FOR EACH ROW EXECUTE FUNCTION kabipay_ops.set_updated_at();</sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS trg_benefit_claim_updated_at ON "${schema}".benefit_claim;</sql>
            <dropTable tableName="benefit_claim" schemaName="${schema}"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
