            <column name="job_id" type="UUID"><constraints nullable="false"/></column>
            <column name="candidate_name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="candidate_email" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="candidate_phone" type="VARCHAR(50)"/>
            <column name="resume_file_storage_id" type="UUID"/>
            <column name="source" type="VARCHAR(100)"/>
            <column name="current_stage_id" type="UUID"/>
            <column name="status" type="VARCHAR(50)"><constraints nullable="false"/></column>
            <column name="workflow_instance_id" type="UUID"/>
            <column name="applied_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="deleted_at" type="TIMESTAMPTZ"/>
            <column name="deleted_by" type="UUID"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="application" schemaName="${schema}" indexName="idx_application_job">
            <column name="job_id"/>
        </createIndex>
        <createIndex tableName="application" schemaName="${schema}" indexName="idx_application_tenant">
            <column name="tenant_id"/>
        </createIndex>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="application" baseColumnNames="job_id"
                                 referencedTableSchemaName="${schema}" referencedTableName="job_posting" referencedColumnNames="id"
                                 constraintName="fk_application_job" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="application" baseColumnNames="current_stage_id"
                                 referencedTableSchemaName="${schema}" referencedTableName="hiring_stage" referencedColumnNames="id"
                                 constraintName="fk_application_stage" onDelete="SET NULL"/>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="application" baseColumnNames="deleted_by"
                                 referencedTableSchemaName="${schema}" referencedTableName="user" referencedColumnNames="id"
                                 constraintName="fk_application_deleted_by" onDelete="SET NULL"/>
        <sql>CREATE TRIGGER trg_application_updated_at BEFORE UPDATE ON "${schema}".application FOR EACH ROW EXECUTE FUNCTION kabipay_ops.set_updated_at();</sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS trg_application_updated_at ON "${schema}".application;</sql>
            <dropTable tableName="application" schemaName="${schema}"/>
        </rollback>
    </changeSet>

