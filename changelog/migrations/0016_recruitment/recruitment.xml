            <column name="description" type="TEXT"/>
            <column name="employment_type" type="VARCHAR(50)"/>
            <column name="vacancies" type="INT" defaultValueNumeric="1"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(50)"><constraints nullable="false"/></column>
            <column name="open_date" type="DATE"/>
            <column name="close_date" type="DATE"/>
            <column name="created_by" type="UUID"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="job_posting" schemaName="${schema}" indexName="idx_job_posting_tenant">
            <column name="tenant_id"/>
        </createIndex>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="job_posting" baseColumnNames="department_id"
                                 referencedTableSchemaName="${schema}" referencedTableName="department" referencedColumnNames="id"
                                 constraintName="fk_job_posting_department" onDelete="SET NULL"/>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="job_posting" baseColumnNames="designation_id"
                                 referencedTableSchemaName="${schema}" referencedTableName="designation" referencedColumnNames="id"
                                 constraintName="fk_job_posting_designation" onDelete="SET NULL"/>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="job_posting" baseColumnNames="location_id"
                                 referencedTableSchemaName="${schema}" referencedTableName="location" referencedColumnNames="id"
                                 constraintName="fk_job_posting_location" onDelete="SET NULL"/>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="job_posting" baseColumnNames="created_by"
                                 referencedTableSchemaName="${schema}" referencedTableName="user" referencedColumnNames="id"
                                 constraintName="fk_job_posting_created_by" onDelete="SET NULL"/>
        <sql>CREATE TRIGGER trg_job_posting_updated_at BEFORE UPDATE ON "${schema}".job_posting FOR EACH ROW EXECUTE FUNCTION kabipay_ops.set_updated_at();</sql>
        <rollback>
