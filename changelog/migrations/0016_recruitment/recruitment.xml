    <!-- DOMAIN 0016 — RECRUITMENT. resume_url replaced with resume_file_storage_id (Gap F). workflow_instance_id deferred to 0025. -->

    <changeSet id="0016-001-create-hiring-stage" author="kabipay-dev">
        <createTable tableName="hiring_stage" schemaName="${schema}">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="sequence_order" type="INT"><constraints nullable="false"/></column>
            <column name="stage_type" type="VARCHAR(50)"/>
            <column name="is_system_stage" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="hiring_stage" schemaName="${schema}" indexName="idx_hiring_stage_tenant">
            <column name="tenant_id"/>
        </createIndex>
        <sql>CREATE TRIGGER trg_hiring_stage_updated_at BEFORE UPDATE ON "${schema}".hiring_stage FOR EACH ROW EXECUTE FUNCTION kabipay_ops.set_updated_at();</sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS trg_hiring_stage_updated_at ON "${schema}".hiring_stage;</sql>
            <dropTable tableName="hiring_stage" schemaName="${schema}"/>
        </rollback>
    </changeSet>

    <changeSet id="0016-002-create-job-posting" author="kabipay-dev">
