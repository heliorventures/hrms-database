            <column name="performance_program_id" type="UUID"><constraints nullable="false"/></column>
            <column name="version" type="INT"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(20)" defaultValue="DRAFT"><constraints nullable="false"/></column>
            <column name="published_at" type="TIMESTAMPTZ"/>
            <column name="published_by" type="UUID"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="appraisal_template" schemaName="${schema}" columnNames="performance_program_id,version" constraintName="uq_appraisal_template_program_version"/>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="appraisal_template" baseColumnNames="performance_program_id" referencedTableSchemaName="${schema}" referencedTableName="performance_program" referencedColumnNames="id" constraintName="fk_appraisal_template_program" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="appraisal_template" baseColumnNames="published_by" referencedTableSchemaName="${schema}" referencedTableName="user" referencedColumnNames="id" constraintName="fk_appraisal_template_published_by" onDelete="SET NULL"/>
        <sql>ALTER TABLE "${schema}".appraisal_template ADD CONSTRAINT chk_appraisal_template_status CHECK (status IN ('DRAFT','PUBLISHED','RETIRED')), ADD CONSTRAINT chk_appraisal_template_version CHECK (version &gt;= 1);</sql>
