    <changeSet id="0075-007-performance-rbac" author="kabipay-dev">
        <sql splitStatements="false"><![CDATA[
INSERT INTO "${schema}".permission (id, resource, action, module_id, description)
SELECT gen_random_uuid(), 'performance', requested.action, module.id, requested.description
FROM (
    VALUES
        ('evaluate', 'Evaluate performance for authorized team members'),
        ('self', 'Manage own goals and appraisal response')
) AS requested(action, description)
JOIN kabipay_ops.module AS module ON UPPER(TRIM(module.code)) = 'EMPLOYEE'
WHERE NOT EXISTS (
    SELECT 1 FROM "${schema}".permission existing
    WHERE LOWER(TRIM(existing.resource)) = 'performance'
      AND LOWER(TRIM(existing.action)) = requested.action
);

INSERT INTO "${schema}".role_permission (role_id, permission_id)
SELECT tenant_role.id, permission.id
FROM "${schema}".role tenant_role
JOIN "${schema}".permission permission
  ON LOWER(TRIM(permission.resource)) = 'performance'
 AND (
      (LOWER(TRIM(permission.action)) = 'evaluate' AND UPPER(TRIM(tenant_role.name)) = 'MANAGER')
      OR
      (LOWER(TRIM(permission.action)) = 'self' AND UPPER(TRIM(tenant_role.name)) IN ('EMPLOYEE','MANAGER','HR','ADMIN'))
 )
WHERE tenant_role.is_deleted = FALSE
  AND NOT EXISTS (
      SELECT 1 FROM "${schema}".role_permission existing
      WHERE existing.role_id = tenant_role.id AND existing.permission_id = permission.id
  );

INSERT INTO "${schema}".permission_scope
    (id, tenant_id, role_id, resource, action, scope_type, created_at)
SELECT gen_random_uuid(), tenant_role.tenant_id, tenant_role.id, 'performance', permission.action,
       CASE permission.action WHEN 'evaluate' THEN 'TEAM' ELSE 'SELF' END, NOW()
FROM "${schema}".role tenant_role
JOIN "${schema}".permission permission
  ON LOWER(TRIM(permission.resource)) = 'performance'
 AND (
      (LOWER(TRIM(permission.action)) = 'evaluate' AND UPPER(TRIM(tenant_role.name)) = 'MANAGER')
      OR
      (LOWER(TRIM(permission.action)) = 'self' AND UPPER(TRIM(tenant_role.name)) IN ('EMPLOYEE','MANAGER','HR','ADMIN'))
 )
WHERE tenant_role.is_deleted = FALSE
  AND NOT EXISTS (
      SELECT 1 FROM "${schema}".permission_scope existing
      WHERE existing.tenant_id = tenant_role.tenant_id
        AND existing.role_id = tenant_role.id
        AND LOWER(TRIM(existing.resource)) = 'performance'
        AND LOWER(TRIM(existing.action)) = LOWER(TRIM(permission.action))
  );
        ]]></sql>
    </changeSet>

    <changeSet id="0075-008-forward-only-rollback-guard" author="kabipay-dev">
        <rollback>
            <sql splitStatements="false"><![CDATA[
DO $$
BEGIN
    RAISE EXCEPTION '0075 performance appraisal lifecycle contains durable responses and requires a forward corrective migration instead of rollback';
END $$;
            ]]></sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
