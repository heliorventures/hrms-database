<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- DOMAIN 0075 - PERFORMANCE, FEEDBACK, AND APPRAISAL LIFECYCLE -->

    <changeSet id="0075-001-performance-program" author="kabipay-dev">
        <createTable tableName="performance_program" schemaName="${schema}">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="description" type="TEXT"/>
            <column name="cadence" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="anchor_date" type="DATE"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(20)" defaultValue="DRAFT"><constraints nullable="false"/></column>
            <column name="include_calibration" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="include_acknowledgement" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="goal_weight_required" type="NUMERIC(7,4)" defaultValueNumeric="100"><constraints nullable="false"/></column>
            <column name="rating_min" type="NUMERIC(7,4)" defaultValueNumeric="1"><constraints nullable="false"/></column>
            <column name="rating_max" type="NUMERIC(7,4)" defaultValueNumeric="5"><constraints nullable="false"/></column>
            <column name="created_by" type="UUID"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="performance_program" schemaName="${schema}" columnNames="tenant_id,name" constraintName="uq_performance_program_tenant_name"/>
        <addForeignKeyConstraint baseTableSchemaName="${schema}" baseTableName="performance_program" baseColumnNames="created_by" referencedTableSchemaName="${schema}" referencedTableName="user" referencedColumnNames="id" constraintName="fk_performance_program_created_by" onDelete="SET NULL"/>
        <sql>ALTER TABLE "${schema}".performance_program ADD CONSTRAINT chk_performance_program_cadence CHECK (cadence IN ('MONTHLY','QUARTERLY','YEARLY','MANUAL')), ADD CONSTRAINT chk_performance_program_status CHECK (status IN ('DRAFT','ACTIVE','ARCHIVED')), ADD CONSTRAINT chk_performance_program_rating CHECK (rating_min &lt; rating_max AND goal_weight_required &gt;= 0);</sql>
        <sql>CREATE TRIGGER trg_performance_program_updated_at BEFORE UPDATE ON "${schema}".performance_program FOR EACH ROW EXECUTE FUNCTION kabipay_ops.set_updated_at();</sql>
    </changeSet>

