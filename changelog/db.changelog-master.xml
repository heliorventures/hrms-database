<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      MASTER CHANGELOG - OPS / CONTROL PLANE
      Run ONCE against the kabipay_dev database. Writes to schema kabipay_ops.
      Usage: liquibase update with defaults file liquibase.properties
    -->

    <!-- Foundation: schema, extensions, updated_at trigger function -->
    <include file="migrations/0000_foundation/foundation.xml" relativeToChangelogFile="true"/>

    <!-- Operator plane (KabiPay internal staff) -->
    <include file="migrations/0001_operator_plane/operator_plane.xml" relativeToChangelogFile="true"/>

    <!-- Control plane (tenant management) -->
    <include file="migrations/0002_control_plane/control_plane.xml" relativeToChangelogFile="true"/>

    <!-- Module catalog & subscription -->
    <include file="migrations/0003_module_catalog/module_catalog.xml" relativeToChangelogFile="true"/>

    <!-- Billing & payments -->
    <include file="migrations/0004_billing/billing.xml" relativeToChangelogFile="true"/>

    <!-- Global integration connector catalog (tenant FKs via cross-schema reference) -->
    <include file="migrations/0005_integration_connector_catalog/integration_connector_catalog.xml" relativeToChangelogFile="true"/>

    <!-- One-time backfill across existing tenants; no tenant-schema changes. -->
    <include file="migrations/0083_missing_module_subscriptions/missing_module_subscriptions.xml" relativeToChangelogFile="true"/>

    <include file="migrations/0104_loan_module_catalog/loan_module_catalog.xml" relativeToChangelogFile="true"/>
    <include file="migrations/0111_organization_foundation/organization_foundation.xml" relativeToChangelogFile="true"/>
    <include file="migrations/0113_organization_control_outbox/organization_control_outbox.xml" relativeToChangelogFile="true"/>
    <include file="migrations/0114_organization_execution/organization_execution.xml" relativeToChangelogFile="true"/>
    <include file="migrations/0116_organization_projections/organization_projections.xml" relativeToChangelogFile="true"/>
    <include file="migrations/0120_organization_capture_lifecycle/organization_capture_lifecycle.xml" relativeToChangelogFile="true"/>
    <include file="migrations/0123_organization_job_authority/organization_job_authority.xml" relativeToChangelogFile="true"/>
    <include file="migrations/0124_private_event_control/private_event_control.xml" relativeToChangelogFile="true"/>
</databaseChangeLog>
